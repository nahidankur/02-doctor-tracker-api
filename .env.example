# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/doctor-tracker
# For MongoDB Atlas (replace <username>, <password>, and <cluster>):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/doctor-tracker?retryWrites=true&w=majority&appName=Cluster0

# Authentication (JWT)
JWT_SECRET=doctor_tracker_secret_jwt_key_assess_token_2026_xyz
JWT_EXPIRES_IN=7d

# Allowed Client Origin (Frontend Next.js app)
CLIENT_ORIGIN=http://localhost:3000
